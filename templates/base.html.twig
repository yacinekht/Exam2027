<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}AdopteUnCompagnon - Refuges & Animaux{% endblock %}</title>

    <!-- CDN Bootstrap 5 & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    {% block stylesheets %}{% endblock %}
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-success shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" href="{{ path('home') }}">
            <i class="bi bi-paw-fill me-2"></i>AdopteUnCompagnon
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('home') }}"><i class="bi bi-house-door"></i> Accueil</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('animaux') }}"><i class="bi bi-heart"></i> Nos Animaux</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#"><i class="bi bi-envelope"></i> Contact</a>
                </li>
                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ORGANIZER') %}
                    <li class="nav-item">
                        <a class="nav-link" href={{ path('new_animal') }}><i class="bi bi-envelope"></i> Ajouter un nouvelle Animal</a>
                    </li>
                {% endif %}


            </ul>

            <!-- Zone Authentification & Déconnexion -->
            <div class="d-flex align-items-center gap-2">
                {% if app.user %}
                    <!-- Nom de l'utilisateur connecté -->
                    <span class="badge rounded-pill text-bg-light border py-2 px-3 fw-medium">
                        <i class="fa-solid fa-user me-1 text-success"></i>
                        {{ app.user.username ?? app.user.userIdentifier }}
                    </span>

                    <!-- Option de Déconnexion -->
                    <a href="{{ path('logout') }}" class="btn btn-outline-light btn-sm py-2 px-3 d-flex align-items-center gap-1" title="Se déconnecter">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        <span>Déconnexion</span>
                    </a>
                {% else %}
                    <!-- Option Connexion / Inscription -->
                    <a href="{{ path('login') }}" class="btn btn-outline-light btn-sm py-2 px-3">
                        <i class="fa-solid fa-right-to-bracket me-1"></i> Connexion / S'inscrire
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</nav>

<!-- Main Content -->
<main class="container my-5 flex-grow-1">
    {% block body %}{% endblock %}
</main>

<!-- Footer -->
<footer class="bg-dark text-white text-center py-4 mt-auto">
    <div class="container">
        <p class="mb-1">&copy; {{ "now"|date("Y") }} AdopteUnCompagnon. Tous droits réservés.</p>
        <small class="text-muted">Offrez-leur une seconde chance <i class="bi bi-heart-fill text-danger"></i></small>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
