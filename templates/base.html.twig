<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}AdopteUnCompagnon - Refuges & Animaux{% endblock %}</title>

    <!-- CDN Bootstrap 5 & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    {% block stylesheets %}{% endblock %}

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap');

        body { font-family: 'Nunito', system-ui, -apple-system, 'Segoe UI', sans-serif; }
        body.bg-light { background: #fff8f0 !important; }

        /* ---------- Barre de navigation ---------- */
        .navbar.bg-success {
            position: relative;
            background: linear-gradient(90deg, #ff7a59 0%, #ff8fab 50%, #8e7dff 100%) !important;
            box-shadow: 0 6px 20px rgba(142, 125, 255, .25) !important;
        }
        .navbar.bg-success::after {
            content: ''; position: absolute; left: 0; right: 0; bottom: -5px; height: 5px;
            background: linear-gradient(90deg, #ffc145, #2ec4b6, #8e7dff, #ff8fab, #ff7a59);
        }
        .navbar-brand { font-weight: 800 !important; font-size: 1.35rem; letter-spacing: .3px; }
        .navbar-brand i { display: inline-block; animation: paw-wiggle 3s ease-in-out infinite; }
        @keyframes paw-wiggle { 0%, 88%, 100% { transform: rotate(0); } 92% { transform: rotate(-14deg); } 96% { transform: rotate(12deg); } }

        .navbar .nav-link {
            color: rgba(255, 255, 255, .92) !important; font-weight: 700; font-size: .95rem;
            white-space: nowrap; border-radius: 999px; padding: .45rem .85rem !important; margin: 0 .1rem;
            transition: background .2s ease, transform .2s ease;
        }
        .navbar .nav-link:hover { background: rgba(255, 255, 255, .25); color: #fff !important; transform: translateY(-2px); }
        .navbar .nav-link i { margin-right: .2rem; }

        .navbar .badge.text-bg-light { background: #fff !important; color: #3b2f4a !important; border: 0 !important; box-shadow: 0 4px 12px rgba(59, 47, 74, .18); }
        .navbar .text-success { color: #ff7a59 !important; }

        .navbar .btn-outline-light {
            border: 2px solid #fff; border-radius: 999px; font-weight: 700;
            transition: background .2s ease, color .2s ease, transform .2s ease;
        }
        .navbar .btn-outline-light:hover { background: #fff; color: #ff7a59; transform: translateY(-2px); }

        /* ---------- Pied de page ---------- */
        footer.bg-dark {
            position: relative;
            background: linear-gradient(135deg, #3b2f4a 0%, #5b3f7a 100%) !important;
        }
        footer.bg-dark::before {
            content: ''; position: absolute; left: 0; right: 0; top: 0; height: 5px;
            background: linear-gradient(90deg, #ffc145, #2ec4b6, #8e7dff, #ff8fab, #ff7a59);
        }
        footer.bg-dark .text-muted { color: #e3d9f0 !important; font-weight: 600; }
        footer.bg-dark .text-danger { color: #ff8fab !important; animation: heartbeat 1.6s ease-in-out infinite; display: inline-block; }
        @keyframes heartbeat { 0%, 100% { transform: scale(1); } 15% { transform: scale(1.3); } 30% { transform: scale(1); } }

        /* ---------- Correctif : menu qui déborde ---------- */
        .navbar > .container { max-width: 100%; padding-left: 1.5rem; padding-right: 1.5rem; }
        .navbar-brand { font-size: 1.2rem; margin-right: 1rem; }
        .navbar .nav-link { font-size: .9rem; padding: .4rem .65rem !important; margin: 0; }
        .navbar .navbar-nav { flex-wrap: wrap; row-gap: .25rem; }
        .navbar .btn-outline-light, .navbar .badge.text-bg-light { white-space: nowrap; }
        @media (min-width: 992px) {
            .navbar-collapse > .d-flex { flex-shrink: 0; margin-left: 1rem; }
        }
        @media (max-width: 991.98px) {
            .navbar .nav-link { border-radius: 14px; }
            .navbar-collapse > .d-flex { margin-top: .75rem; flex-wrap: wrap; }
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-success shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" href="{{ path('home') }}">
            <i class="bi bi-paw-fill me-2"></i>AdopteUnCompagnon
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('home') }}"><i class="bi bi-house-door"></i> Accueil</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('animaux') }}"><i class="bi bi-heart"></i> Nos Animaux</a>
                </li>

                {# Lien visible uniquement pour un utilisateur connecté #}
                {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('mes_demandes') }}"><i class="bi bi-clipboard-heart"></i> Mes demandes</a>
                    </li>
                {% endif %}

                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ORGANIZER') %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('new_animal') }}"><i class="bi bi-plus-circle"></i> Ajouter un nouvel animal</a>
                    </li>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ORGANIZER') %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('demandes_list') }}"><i class="bi bi-inbox"></i> Gérer les demandes</a>
                    </li>
                {% endif %}
            </ul>

            <!-- Zone Authentification & Déconnexion -->
            <div class="d-flex align-items-center gap-2">
                {% if app.user %}
                    <!-- Nom de l'utilisateur connecté -->
                    <span class="badge rounded-pill text-bg-light border py-2 px-3 fw-medium">
                        <i class="fa-solid fa-user me-1 text-success"></i>
                        {{ app.user.username ?? app.user.userIdentifier }}
                    </span>

                    <!-- Option de Déconnexion -->
                    <a href="{{ path('logout') }}" class="btn btn-outline-light btn-sm py-2 px-3 d-flex align-items-center gap-1" title="Se déconnecter">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        <span>Déconnexion</span>
                    </a>
                {% else %}
                    <!-- Option Connexion / Inscription -->
                    <a href="{{ path('login') }}" class="btn btn-outline-light btn-sm py-2 px-3">
                        <i class="fa-solid fa-right-to-bracket me-1"></i> Connexion / S'inscrire
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</nav>

<!-- Main Content -->
<main class="container my-5 flex-grow-1">
    {% block body %}{% endblock %}
</main>

<!-- Footer -->
<footer class="bg-dark text-white text-center py-4 mt-auto">
    <div class="container">
        <p class="mb-1">&copy; {{ "now"|date("Y") }} AdopteUnCompagnon. Tous droits réservés.</p>
        <small class="text-muted">Offrez-leur une seconde chance <i class="bi bi-heart-fill text-danger"></i></small>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
