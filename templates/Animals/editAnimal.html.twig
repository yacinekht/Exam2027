{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Modifier {{ animal.name ?? 'un animal' }}{% endblock %}

{% block body %}
    {{ include('_animal_theme.html.twig') }}
    <div class="animal-theme">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h1 class="fw-bold m-0">
                    <i class="fa-solid fa-pen-to-square text-success me-2"></i>Modifier {{ animal.name ?? 'l\'animal' }}
                </h1>
                <p class="text-muted small mt-1">Mettez à jour les informations relatives à cet animal.</p>
            </div>
            <a href="{{ path('animaux') }}" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i> Retour à la liste
            </a>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-4 p-4 bg-white">

                    {# Cas 1 : Si vous utilisez FormType de Symfony #}
                    {% if form is defined %}
                        {{ form_start(form) }}

                        {# Affiche automatiquement tous les champs du formulaire avec mise en page Bootstrap #}
                        <div class="row g-3">
                            {% for child in form %}
                                {% if child.vars.name != '_token' %}
                                    <div class="col-md-6 mb-3">
                                        {{ form_label(child, null, {'label_attr': {'class': 'form-label small fw-bold'}}) }}
                                        {{ form_widget(child, {'attr': {'class': 'form-control bg-light'}}) }}
                                        {{ form_errors(child) }}
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a href="{{ path('animaux') }}" class="btn btn-outline-secondary px-4">Annuler</a>
                            <button type="submit" class="btn btn-success px-4">
                                <i class="fa-solid fa-floppy-disk me-1"></i> Enregistrer les modifications
                            </button>
                        </div>

                        {{ form_end(form) }}

                        {# Cas 2 : Formulaire HTML classique si vous ne passez pas de FormType #}
                    {% else %}
                        <form method="post">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="name" class="form-label small fw-bold">Nom</label>
                                    <input type="text" id="name" name="name" class="form-control bg-light" value="{{ animal.name ?? '' }}" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="espece" class="form-label small fw-bold">Espèce</label>
                                    <input type="text" id="espece" name="espece" class="form-control bg-light" value="{{ animal.espece ?? '' }}" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="race" class="form-label small fw-bold">Race</label>
                                    <input type="text" id="race" name="race" class="form-control bg-light" value="{{ animal.race ?? '' }}" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="age" class="form-label small fw-bold">Âge (ans)</label>
                                    <input type="number" id="age" name="age" class="form-control bg-light" value="{{ animal.age ?? '' }}" required>
                                </div>
                                <div class="col-12">
                                    <label for="description" class="form-label small fw-bold">Description</label>
                                    <textarea id="description" name="description" rows="4" class="form-control bg-light">{{ animal.description ?? '' }}</textarea>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                                <a href="{{ path('animaux') }}" class="btn btn-outline-secondary px-4">Annuler</a>
                                <button type="submit" class="btn btn-success px-4">
                                    <i class="fa-solid fa-floppy-disk me-1"></i> Enregistrer les modifications
                                </button>
                            </div>
                        </form>
                    {% endif %}

                </div>
            </div>
        </div>
    </div>
{% endblock %}
